#!/usr/bin/env bash
set -euo pipefail

set -a
# shellcheck disable=SC1091
. /var/run/mem-zero.env
set +a

for _ in $(seq 1 60); do
    curl -fsS "http://127.0.0.1:6333/readyz" >/dev/null 2>&1 && break
    sleep 1
done

if ! curl -fsS "http://127.0.0.1:6333/readyz" >/dev/null 2>&1; then
    echo "[mem-zero] Qdrant not ready after 60s; s6 will restart this service and retry" >&2
    exit 1
fi

RUN_AS="$(cat /var/run/mem-zero.user 2>/dev/null || echo root)"
export HOME=/mem-zero/storage
cd /app
# /var/run/mem-zero.env (mode 600) was sourced above as root; s6-setuidgid
# passes the environment through to the unprivileged service.
exec /command/s6-setuidgid "$RUN_AS" /opt/venv/bin/uvicorn mem_zero.server:app --host "${HOST:-0.0.0.0}" --port "${PORT:-8765}"
